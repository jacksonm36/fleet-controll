# Install PostgreSQL on the host (or use any reachable instance) and create a database + user.
# This project does not ship or require Docker for the database or app runtime.
DATABASE_URL="postgresql://fleet:fleet@localhost:5432/fleet?schema=public&connection_limit=10"

# Redis caches dashboard/agents/crowdsec API reads (recommended for UI speed).
REDIS_URL="redis://127.0.0.1:6379"

JWT_SECRET="replace-with-at-least-32-chars-long-secret-key-here!!"
# Optional pepper for deterministic Argon2id hashes on enrollment/agent API tokens (defaults to JWT_SECRET).
TOKEN_PEPPER=""
API_PORT=4000
NEXT_PUBLIC_API_URL="https://localhost"
# Next.js server rewrites /api/* to this (loopback HTTP — do not use https public URL here)
API_UPSTREAM_URL="http://127.0.0.1:4000"
# Auto HTTPS install scripts + encrypted enrollment (see docs/SECURITY-TLS.md)
FLEET_AUTO_ENCRYPT=1
FLEET_REQUIRE_TLS=1
FLEET_PUBLIC_HOST=
FLEET_PUBLIC_URL=
FLEET_CA_CERT_PATH=/etc/fleet/ca.crt
FLEET_TLS_PROXY=nginx
# FLEET_HSTS=1
# TRUST_PROXY=1
# Raw GitHub prefix for agent install script (Enrollment page copy-paste)
NEXT_PUBLIC_FLEET_GITHUB_RAW_BASE="https://raw.githubusercontent.com/jacksonm36/fleet-controll/main"
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
# Web UI session cookie (httpOnly JWT). Auto-secure when FLEET_REQUIRE_TLS=1.
SESSION_COOKIE_SECURE=0
# Production: NODE_ENV=production, TRUST_PROXY=1, FLEET_REQUIRE_TLS=1, strong JWT_SECRET (32+ chars).
NODE_ENV=development
TRUST_PROXY=0
# Lab only — cleartext HTTP: FLEET_AUTO_ENCRYPT=0 FLEET_REQUIRE_TLS=0
# Agent long-poll backoff when no jobs (ms). Lower = snappier jobs, more DB wakeups.
AGENT_JOB_POLL_MS=600
# Regex for systemd units operators may restart/stop/start (default ".*" = all — tighten in production)
# SERVICE_ALLOWLIST="fleet-agent\\.service|nginx\\.service"
# Disable arbitrary shell automation jobs on agents
# AUTOMATION_DISABLE_SHELL=1
# Enrollment brute-force limit per IP (per 15 min)
# ENROLL_RATE_MAX=20
# Password rules (min length; requires letter + digit)
# PASSWORD_MIN_LENGTH=12
# Session cookie SameSite: lax | strict | none (production defaults to lax)
# SESSION_COOKIE_SAMESITE=lax
# CSP report-only headers (browser console) — not enforced yet
# CSP_REPORT_ONLY=1
# Dedicated pepper for token hashing (recommended in production)
# TOKEN_PEPPER=
# Mark agents offline if no heartbeat/command poll within this window (ms).
AGENT_ONLINE_THRESHOLD_MS=45000

# Observability — InfluxDB (metrics) + Grafana + Loki (logs). Native apt install — see docs/OBSERVABILITY.md
# Run: sudo bash scripts/install-fleet-observability.sh
# Docker on agents is for container inventory/monitoring only, not this stack.
INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=fleet-influx-dev-token-change-in-production
INFLUX_ORG=fleet
INFLUX_BUCKET=host_metrics
LOKI_URL=http://127.0.0.1:3100
GRAFANA_PUBLIC_URL=http://127.0.0.1:3002
NEXT_PUBLIC_GRAFANA_URL=http://127.0.0.1:3002

# Generate JWT + initial admin password into .env locally:
#   npm run env:generate
#
# After changing these, apply with: npm run db:seed
SEED_ADMIN_EMAIL="admin@localhost"
SEED_ADMIN_PASSWORD="set-via-env-generate-or-strong-secret"

# Bootstrap DB + deps on WSL (after PostgreSQL listens on DATABASE_URL):
#   bash scripts/bootstrap-wsl.sh
# From Windows CMD (same script via WSL):
#   scripts\run-bootstrap-wsl.cmd