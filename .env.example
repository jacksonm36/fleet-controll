# Install PostgreSQL on the host (or use any reachable instance) and create a database + user.
# This project does not ship or require Docker for the database or app runtime.
DATABASE_URL="postgresql://fleet:fleet@localhost:5432/fleet?schema=public&connection_limit=10"

# Optional: Redis on the host (e.g. a local redis-server install). Used when wired in; safe to omit if unused.
REDIS_URL="redis://localhost:6379"

JWT_SECRET="replace-with-at-least-32-chars-long-secret-key-here!!"
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Raw GitHub prefix for agent install script (Enrollment page copy-paste)
NEXT_PUBLIC_FLEET_GITHUB_RAW_BASE="https://raw.githubusercontent.com/jacksonm36/fleet-controll/main"
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
# Production: set NODE_ENV=production, TRUST_PROXY=1 behind nginx/caddy, and a strong JWT_SECRET (32+ chars).
NODE_ENV=development
TRUST_PROXY=0
# Agent long-poll backoff when no jobs (ms). Lower = snappier jobs, more DB wakeups.
AGENT_JOB_POLL_MS=1200

# Generate JWT + initial admin password into .env locally:
#   npm run env:generate
#
# After changing these, apply with: npm run db:seed
SEED_ADMIN_EMAIL="admin@localhost"
SEED_ADMIN_PASSWORD="set-via-env-generate-or-strong-secret"

# Bootstrap DB + deps on WSL (after PostgreSQL listens on DATABASE_URL):
#   bash scripts/bootstrap-wsl.sh
# From Windows CMD (same script via WSL):
#   scripts\run-bootstrap-wsl.cmd