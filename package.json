{
  "name": "fleet-patch-control",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "env:generate": "node scripts/gen-env.mjs",
    "db:generate": "npm run db:generate --workspace=@fleet/db",
    "db:migrate": "npm run db:migrate --workspace=@fleet/db",
    "db:push": "npm run db:push --workspace=@fleet/db",
    "db:seed": "npm run db:seed --workspace=@fleet/db"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@10.9.0",
  "workspaces": ["apps/*", "packages/*"]
}
