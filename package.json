{
  "name": "fleet-patch-control",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:web": "npm run lint --workspace=@fleet/web",
    "audit": "npm audit",
    "outdated": "npm outdated",
    "env:generate": "node scripts/gen-env.mjs",
    "db:generate": "npm run db:generate --workspace=@fleet/db",
    "db:migrate": "npm run db:migrate --workspace=@fleet/db",
    "db:push": "npm run db:push --workspace=@fleet/db",
    "db:seed": "npm run db:seed --workspace=@fleet/db"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/ws": "^8.18.1",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.15",
    "next": {
      "postcss": "8.5.15"
    },
    "fast-jwt": "6.2.4"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": ["apps/*", "packages/*"]
}
